// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`generateCompose > matches the snapshot 1`] = `
"# Generated by Odoo Branch Manager for demz/19.0-demz-crm build #3. Do not edit: it is rewritten on each build.
name: bm-demz-crm
services:
  odoo:
    image: demz-odoo-19-odoo
    command:
      - python3
      - -Xfrozen_modules=off
      - -m
      - debugpy
      - --listen
      - 0.0.0.0:5678
      - /usr/bin/odoo
      - -c
      - /etc/odoo/odoo.conf
      - --data-dir=/var/lib/odoo
      - --addons-path=/usr/lib/python3/dist-packages/odoo/addons,/mnt/repositories/demz-odoo/demzua/perevertum/crm,/mnt/repositories/demz-odoo/exchange
      - -d
      - o19_br_crm_3
      - --db-filter=^o19_br_crm_3$$
      - --proxy-mode
    environment:
      HOST: db
      USER: odoo
      PASSWORD: pa$$s
    volumes:
      - type: bind
        source: E:/demz-odoo-19/repositories
        target: /mnt/repositories
        read_only: true
      - type: bind
        source: E:/demz-odoo-19/enterprise
        target: /mnt/enterprise
        read_only: true
      - type: bind
        source: E:/demz-odoo-19/config/odoo.conf
        target: /etc/odoo/odoo.conf
        read_only: true
      - type: bind
        source: E:/demz-odoo-19/worktrees/demz/crm
        target: /mnt/repositories/demz-odoo
      - type: bind
        source: E:/demz-odoo-19/data/filestore
        target: /var/lib/odoo/filestore
    networks:
      - demz-odoo-19_default
    ports:
      - 127.0.0.1:5701:5678
    labels:
      bm.project: demz
      bm.branch: "7"
      bm.branch.name: 19.0-demz-crm
      bm.build: "42"
      bm.build.number: "3"
      bm.stage: development
      bm.db: o19_br_crm_3
      bm.slug: crm
      bm.url: http://crm.localhost:8080
      bm.protected: "true"
      bm.odoo.args: -c /etc/odoo/odoo.conf --data-dir=/var/lib/odoo --addons-path=/mnt/repositories/demz-odoo/exchange
      traefik.enable: "true"
      traefik.docker.network: demz-odoo-19_default
      traefik.http.routers.bm-demz-crm.rule: Host(\`crm.localhost\`)
      traefik.http.routers.bm-demz-crm.entrypoints: web
      traefik.http.routers.bm-demz-crm.service: bm-demz-crm
      traefik.http.services.bm-demz-crm.loadbalancer.server.port: "8069"
    healthcheck:
      test:
        - CMD
        - python3
        - -c
        - import urllib.request; urllib.request.urlopen('http://localhost:8069/web/login', timeout=10)
      interval: 10s
      timeout: 12s
      retries: 3
      start_period: 120s
    restart: unless-stopped
    stop_grace_period: 20s
networks:
  demz-odoo-19_default:
    external: true
    name: demz-odoo-19_default
"
`;
