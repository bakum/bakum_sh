{
  "name": "@bm/desktop",
  "productName": "Odoo Branch Manager",
  "version": "0.1.2",
  "private": true,
  "description": "Odoo Branch Manager: local odoo.sh for Windows + Docker Desktop",
  "author": "Bakum Viacheslav",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/electron-vite.mjs dev",
    "build": "node scripts/electron-vite.mjs build",
    "start": "node scripts/electron-vite.mjs preview --skipBuild",
    "package": "node scripts/electron-vite.mjs build && electron-builder --win --config electron-builder.yml",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "rebuild-native": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chokidar": "^4.0.3",
    "croner": "^9.1.0",
    "dockerode": "^4.0.9",
    "drizzle-orm": "^0.44.7",
    "execa": "^9.6.0",
    "jsonc-parser": "^3.3.1",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@bm/core": "workspace:*",
    "@bm/shared": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@mantine/core": "^8.3.5",
    "@mantine/hooks": "^8.3.5",
    "@mantine/notifications": "^8.3.5",
    "@monaco-editor/react": "^4.7.0",
    "@tabler/icons-react": "^3.35.0",
    "@tanstack/react-query": "^5.90.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "44.4.5",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "monaco-editor": "^0.54.0",
    "monaco-yaml": "^5.4.0",
    "playwright": "^1.56.0",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  }
}
